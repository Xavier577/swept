{
  "name": "swept-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4310 --strictPort",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4310 --strictPort",
    "format": "prettier --write src scripts e2e *.ts *.json index.html",
    "releases:sync": "node scripts/releases.mjs",
    "test": "node --test scripts/releases.test.mjs",
    "test:ui": "playwright test",
    "format:check": "prettier --check src scripts e2e *.ts *.json index.html"
  },
  "dependencies": {
    "@lucide/vue": "1.70.0",
    "vue": "3.5.45"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@vitejs/plugin-vue": "6.0.10",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "vite": "8.3.7",
    "vue-tsc": "3.3.14"
  }
}
